# 安装时复制到 /etc/led-gateway/led-gateway.env；此文件不要提交真实密钥
# 根据工控机实际串口修改（建议使用 /dev/serial/by-id/... 的稳定设备名）
LED_SERIAL_PORT=/dev/ttyUSB0
LED_SERIAL_TIMEOUT=0.7
LED_SERIAL_WRITE_TIMEOUT=1.0
# 平台后端通过网络访问工控机：监听全部网卡并配置强 API Key
LED_HTTP_HOST=0.0.0.0
LED_HTTP_PORT=8090
LED_API_KEY=PLEASE_CHANGE_TO_A_LONG_RANDOM_SECRET
