[Unit]
Description=Robot Camera HTTP Service
After=network-online.target
Wants=network-online.target

[Service]
User=hzauaiot
WorkingDirectory=/home/hzauaiot/pig_project
ExecStart=/usr/bin/python3 /home/hzauaiot/pig_project/robot_camera_server.py --host 0.0.0.0 --port 5000 --camera-index 0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
